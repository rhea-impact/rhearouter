# RheaRouter Configuration

# Application
APP_NAME=RheaRouter
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=300

# Rate Limiting
GLOBAL_RATE_LIMIT=60
PER_CLIENT_RATE_LIMIT=20
RATE_LIMIT_BURST=10

# VRAM Flow Valve
VISION_SLOTS=1
TEXT_SLOTS=2

# Models
DEFAULT_TEXT_MODEL=llama3.1:8b
DEFAULT_VISION_MODEL=minicpm-v:8b
REASONING_MODEL=deepseek-r1:8b
